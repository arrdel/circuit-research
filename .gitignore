# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/

# Packaging / build
*.egg-info/
dist/
build/

# Artifacts, caches, and heavy outputs
artifacts/
outputs/
results/
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.pdf

# Keep checked-in figures, E0/E1 pilot deliverables, or configs if explicitly added
!paper/*.tex
!paper/*.bib
!experiments/configs/**
!experiments/e0/**/*.png
!experiments/e0/*.png
!experiments/e1/**/*.png
!experiments/e1/*.png

# Secrets and local IDE
.env
.env.*
.DS_Store
.pytest_cache/
.ruff_cache/
